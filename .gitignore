# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# ---- 运行产物：缓存（程序自动重建，不入库） ----
# HTTP 响应缓存、城市索引归一化缓存、原始响应（cache/raw）等，
# 由 fetch.cache.dir / fetch.raw_dir 控制；仅保留顶层说明文件。
cache/*
!cache/说明.md

# ---- 运行产物：自定义配置（程序自动重建，不入库） ----
config/custom/*
!config/custom/.gitkeep

# ---- 运行产物：交付物（表格与图，可由命令重新生成，不入库） ----
# output/ 下的 CSV / Markdown / XLSX / JSON / PNG / SVG / PDF 等均为生成物，
# 执行 python wmo_climate.py 即可重新产出；仅保留 .gitkeep 以维持目录结构。
output/*
!output/.gitkeep

# ---- 测试产物（回归测试自动重建，不入库） ----
# tests/_output/ 下为表格中间输出与渲染核对图，仅保留顶层说明文件。
tests/_output/*
!tests/_output/说明.md

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
~$*

# ---- 本地配置 ----
# --init-profile 导出的个人配置模板，不入库
config/my_style.json

# ---- 工具元数据 ----
# .workbuddy 为本地工具的项目记忆与配置，含机器相关信息（本地路径、代理等），
# 不入公开仓库。项目设计规划与使用方式已由 README.md / 开发计划.md /
# config/README.md / 过程文件/*/说明.md 完整覆盖。
.workbuddy/
