# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# ---- 运行期缓存与可重建的中间产物 ----
# 缓存由程序按 fetch.cache.dir 自动生成，无需入库；
# 但保留目录说明文件，便于克隆后理解目录用途。
过程文件/中间产物/*
!过程文件/中间产物/说明.md
过程文件/**/raw/

# ---- 交付物：表格与图（可由命令重新生成，不入库） ----
# output/ 下的 CSV / Markdown / XLSX / JSON / PNG / SVG / PDF 等均为生成物，
# 执行 python wmo_climate.py 即可重新产出，无需入库；
# 仅保留 .gitkeep 以维持目录结构。
output/*
!output/.gitkeep

# ---- 校验渲染图（回归测试自动重建，本地保留不入库） ----
# 每次运行 python tests/test_regression.py 都会重新生成（约 2.5 MB），
# 因此不入库；各图核对要点见 过程文件/校验渲染/说明.md。
过程文件/校验渲染/**/*.png

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
~$*

# ---- 本地配置 ----
# --init-profile 导出的个人配置模板，不入库
config/my_style.json

# ---- 工具元数据 ----
# .workbuddy 为本地工具的项目记忆与配置，含机器相关信息（本地路径、代理等），
# 不入公开仓库。项目设计规划与使用方式已由 README.md / 开发计划.md /
# config/README.md / 过程文件/*/说明.md 完整覆盖。
.workbuddy/
